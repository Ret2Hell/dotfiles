{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/mimo-v2.6-pro",
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "options": {
            "textVerbosity": "low"
          }
        },
        "gpt-5.6-luna": {
          "options": {
            "reasoningEffort": "max",
            "textVerbosity": "low"
          }
        }
      }
    },
    "opencode-go": {
      "models": {
        "deepseek-v4.1-flash": {
          "options": {
            "reasoningEffort": "max"
          }
        },
        "mimo-v2.6-pro": {
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  },
  "agent": {
    "explore": {
      "model": "opencode-go/mimo-v2.6-pro"
    }
  },
  "mcp": {
    "i18n-mcp": {
      "type": "local",
      "enabled": true,
      "command": ["/home/ret2hell/.local/bin/i18n-mcp", "serve", "stdio", "--project", "."]
    }
  }
}
