{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-flash",
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "options": {
            "textVerbosity": "low"
          }
        },
        "gpt-5.6-luna": {
          "options": {
            "reasoningEffort": "max",
            "textVerbosity": "low"
          }
        }
      }
    },
    "opencode-go": {
      "models": {
        "deepseek-v4-flash": {
          "options": {
            "reasoningEffort": "max"
          }
        }
      }
    }
  },
  "agent": {
    "explore": {
      "model": "opencode-go/deepseek-v4-flash"
    }
  },
  "mcp": {
    "i18n-mcp": {
      "type": "local",
      "enabled": true,
      "command": [
        "/home/ret2hell/.local/bin/i18n-mcp",
        "serve",
        "stdio",
        "--project",
        "."
      ]
    }
  }
}
