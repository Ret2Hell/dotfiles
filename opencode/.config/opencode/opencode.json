{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "providers": {
    "openai": {
      "settings": {
        "textVerbosity": "low"
      },
      "models": {
        "gpt-6.1-sol": {
          "settings": {
            "reasoningEffort": "medium"
          }
        }
      }
    }
  },
  "agents": {
    "explore": {
      "model": "openai/gpt-6-luna#max"
    }
  },
  "mcp": {
    "i18n-mcp": {
      "type": "local",
      "enabled": true,
      "command": ["/home/ret2hell/.local/bin/i18n-mcp", "serve", "stdio", "--project", "."]
    }
  }
}
