# Machine-local mise settings and group selection
mise.local.toml

# Zsh runtime state (history, compdump) must not be tracked
zsh/.config/zsh/.zsh_history
zsh/.config/zsh/.zcompdump*
zsh/.config/zsh/*.zwc

# Runtime state and generated files
*.log
*.bak
*.bak.*
herdr/.config/herdr/session.json
herdr/.config/herdr/release-notes.json
omarchy/.config/omarchy/current/
**/node_modules/
